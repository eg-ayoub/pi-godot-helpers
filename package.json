{
  "name": "pi-godot-helpers",
  "version": "0.1.0",
  "description": "pi.dev extension: a Godot design advisor and a PR reviewer with routed GodotPrompter skills, a sandbox and long-term memory",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "pi-package",
    "godot",
    "code-review"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/eg-ayoub/pi-godot-helpers.git"
  },
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "typecheck": "tsc --noEmit",
    "eval:routing": "node --experimental-strip-types scripts/eval-routing.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^22.0.0",
    "typebox": "1.3.27",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
